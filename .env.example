# Copy to .env (gitignored). Never commit real values.
CARELITE_UNPAYWALL_EMAIL=you@example.com
CARELITE_DATABASE_URL=postgresql://localhost:5432/carelite
CARELITE_OLLAMA_HOST=http://localhost:11434

# vLLM batch backend (see docs/superpowers/specs/2026-09-01-langgraph-vllm-completion-design.md).
# CARELITE_BACKEND selects the serving stack: "ollama" (default, local) or "vllm" (remote pod).
# The API key is generated locally, not issued by anyone — RunPod proxy URLs are public,
# so the endpoint is authenticated. Never commit a real value.
CARELITE_BACKEND=ollama
CARELITE_VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
CARELITE_VLLM_API_KEY=generate-your-own
